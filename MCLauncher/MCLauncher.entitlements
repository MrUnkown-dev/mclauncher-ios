<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Keep this file MINIMAL for AltStore / Sideloadly free-Apple-ID signing.
	  Free provisioning profiles reject most entitlement requests and will fail
	  to install if you ask for them. Only the keys below are safe with a free ID.

	  If you have a PAID Apple Developer account, you may add:
	    <key>com.apple.security.cs.allow-jit</key><true/>
	    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
	    <key>get-task-allow</key><true/>
	  ...which enables the JVM's JIT for a large speed-up. See BUILD.md → JIT.
	-->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(TeamIdentifierPrefix)</string>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
